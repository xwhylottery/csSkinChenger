    ["Sawed-Off"]="Shotguns",["Negev"]="Shotguns",
    ["C4"]="Other",["HE Grenade"]="Other",["Smoke Grenade"]="Other",
    ["Flashbang"]="Other",["Molotov"]="Other",["Incendiary Grenade"]="Other",
    ["Decoy Grenade"]="Other",
}

local function isGloveType(name)
    for _, g in ipairs(GLOVE_TYPES) do if g == name then return true end end
    return false
end

local function collectSkins()
    local skins = RS:FindFirstChild("Assets") and RS.Assets:FindFirstChild("Skins")
    if not skins then return end
    for _, weaponFolder in ipairs(skins:GetChildren()) do
        local weaponName = weaponFolder.Name
        local skinList = {}
        for _, skinFolder in ipairs(weaponFolder:GetChildren()) do
            if skinFolder:IsA("Folder") and (skinFolder:FindFirstChild("Camera") or skinFolder:FindFirstChild("Character")) then
                table.insert(skinList, skinFolder.Name)
            end
        end
        if #skinList > 0 then
            table.sort(skinList)
            AllSkins[weaponName] = skinList
            if not isGloveType(weaponName) then
                local cat = CATEGORY_MAP[weaponName] or "Other"
                table.insert(Categories[cat], weaponName)
            end
        end
    end
    for _, list in pairs(Categories) do table.sort(list) end
end

collectSkins()

-- 3. ПОИСК ОРУЖИЯ
local ALL_WEAPON_NAMES = {}
for name, _ in pairs(AllSkins) do table.insert(ALL_WEAPON_NAMES, name) end
table.sort(ALL_WEAPON_NAMES, function(a,b) return #a > #b end)

local function findWeaponInHand()
    for _, obj in ipairs(workspace.CurrentCamera:GetChildren()) do
        if obj:IsA("Model") and AllSkins[obj.Name] then
            return obj, obj.Name
        end
    end
    for _, obj in ipairs(workspace.CurrentCamera:GetChildren()) do
        if obj:IsA("Model") then
            for _, w in ipairs(ALL_WEAPON_NAMES) do
                if string.find(string.lower(obj.Name), string.lower(w)) then
                    return obj, w
                end
            end
        end
    end
    return nil, nil
end

local function getAnyViewModel()
    for _, obj in ipairs(workspace.CurrentCamera:GetChildren()) do
        if obj:IsA("Model") and obj:FindFirstChild("Weapon") then return obj end
    end
    return nil
end

-- 4. ПРИМЕНЕНИЕ
local function applyWeaponSkin(weaponName, skinName)
    local vm = findWeaponInHand()
    if not vm then return false end
    local weapon = vm:FindFirstChild("Weapon")
    if not weapon then return false end
    local weaponFolder = RS.Assets.Skins:FindFirstChild(weaponName)
    if not weaponFolder then return false end
    local skinFolder = weaponFolder:FindFirstChild(skinName)
    if not skinFolder then return false end
    local camera = skinFolder:FindFirstChild("Camera")
    if not camera then return false end
    local condition = camera:FindFirstChild("Factory New") or camera:GetChildren()[1]
    if not condition then return false end
    for _, part in ipairs(weapon:GetDescendants()) do
        if part:IsA("MeshPart") then
            local sa = condition:FindFirstChild(part.Name)
            if sa and sa:IsA("SurfaceAppearance") then
                local old = part:FindFirstChildOfClass("SurfaceAppearance")
                if old then old:Destroy() end
                sa:Clone().Parent = part
            end
        end
    end
    print("[SkinChanger] ✅ " .. weaponName .. " → " .. skinName)
    return true
end

local function applyGloveSkin(gloveType, skinName)
    local vm = getAnyViewModel()
    if not vm then return false end
    local gloveFolder = RS.Assets.Skins:FindFirstChild(gloveType)
    if not gloveFolder then return false end
    local skinFolder = gloveFolder:FindFirstChild(skinName)
    if not skinFolder then return false end
    local camera = skinFolder:FindFirstChild("Camera")
    if not camera then return false end
    local condition = camera:FindFirstChild("Factory New") or camera:GetChildren()[1]
    if not condition then return false end
    local saLeft = condition:FindFirstChild("Left Arm")
    local saRight = condition:FindFirstChild("Right Arm")
    local applied = 0
    for _, armName in ipairs({"Left Arm", "Right Arm"}) do
        local arm = vm:FindFirstChild(armName)
        if arm then
            local srcSA = (armName == "Left Arm") and saLeft or saRight
            if srcSA then
                for _, c in ipairs(arm:GetChildren()) do
                    if c:IsA("SurfaceAppearance") then c:Destroy() end
                end
                srcSA:Clone().Parent = arm
                applied = applied + 1
                for _, sub in ipairs(arm:GetChildren()) do
                    if sub:IsA("MeshPart") and (sub.Name == "Glove" or sub.Name == "Sleeve") then
                        for _, c in ipairs(sub:GetChildren()) do
                            if c:IsA("SurfaceAppearance") then c:Destroy() end
                        end
                        srcSA:Clone().Parent = sub
                        applied = applied + 1
                    end
                end
            end
        end
    end
    print("[SkinChanger] 🧤 " .. gloveType .. " → " .. skinName)
    return true
end

