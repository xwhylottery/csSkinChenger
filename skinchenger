local CATEGORY_MAP = {
    ["Karambit"]="Knives",["Butterfly Knife"]="Knives",["Gut Knife"]="Knives",
    ["Flip Knife"]="Knives",["Stiletto Knife"]="Knives",["Skeleton Knife"]="Knives",
