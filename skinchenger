-- Автопереприменение при смене оружия
task.spawn(function()
    local lastDetected = nil
    while true do
        task.wait(0.5)
        local _, weaponName = findWeaponInHand()
        if weaponName and weaponName ~= lastDetected then
            lastDetected = weaponName
            if lastApplied[weaponName] then
                task.wait(0.15)
                applyWeaponSkin(weaponName, lastApplied[weaponName])
            end
            if lastApplied["GLOVE"] then
                task.wait(0.15)
                applyGloveSkin(lastApplied["GLOVE"].type, lastApplied["GLOVE"].skin)
            end
        elseif not weaponName then
            lastDetected = nil
        end
    end
end)

