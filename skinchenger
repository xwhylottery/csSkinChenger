    ["Glock-18"]="Pistols",["USP-S"]="Pistols",["P250"]="Pistols",
    ["Five-SeveN"]="Pistols",["Tec-9"]="Pistols",["Desert Eagle"]="Pistols",
    ["Dual Berettas"]="Pistols",["R8 Revolver"]="Pistols",["Zeus x27"]="Pistols",
    ["AK-47"]="Rifles",["M4A4"]="Rifles",["M4A1-S"]="Rifles",
    ["FAMAS"]="Rifles",["Galil AR"]="Rifles",["AUG"]="Rifles",["SG 553"]="Rifles",
