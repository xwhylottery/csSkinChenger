-- Вкладки с оружием
local lastApplied = {}

local function createWeaponTab(tab, weaponsList)
    if #weaponsList == 0 then
        tab:AddSection("Пусто"):AddParagraph({
            Title = "Нет оружия в категории",
            Content = "В этой категории ничего нет"
        })
        return
    end
    for _, weaponName in ipairs(weaponsList) do
        local skinsList = AllSkins[weaponName] or {}
        if #skinsList > 0 then
            local section = tab:AddSection(weaponName)
            section:AddDropdown(weaponName .. "_Skin", {
                Title = "Выбери скин",
                Description = "Применить к " .. weaponName,
                Values = skinsList,
                Multi = false,
                Default = nil,
                Callback = function(value)
                    if not value then return end
                    lastApplied[weaponName] = value
                    applyWeaponSkin(weaponName, value)
                end
            })
        end
    end
end

